rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /facilities/{facilityId} {
      allow read, write: if true;
    }
    match /passports/{passportId} {
      allow read, write: if true;
    }
    match /sensor_telemetry/{telemetryId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
